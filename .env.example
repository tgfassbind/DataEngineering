# Object storage credentials
# Used by both the storage service and the fetcher.
S3_ACCESS_KEY_ID=deng-datapipeline-istdaten
S3_SECRET_ACCESS_KEY=change-me

# Object storage location
S3_ENDPOINT_URL=http://object-storage:8333
S3_BUCKET=sbb-ist-daten
S3_REGION=us-east-1
# The local storage service creates S3_BUCKET itself; keep false.
S3_CREATE_BUCKET=false
# How long the fetcher waits for the bucket to appear after storage starts.
S3_BUCKET_WAIT_SECONDS=60
S3_API_PORT=8333

# Sources, where to download the data from
# {day} -> YYYY-MM-DD
PERMALINK_URL_TEMPLATE="https://data.opentransportdata.swiss/dataset/ist-daten-v2/resource_permalink/{day}_istdaten.csv"
# {year} -> YYYY, {month} -> MM
ARCHIVE_URL_TEMPLATE="https://archive.opentransportdata.swiss/istdaten/{year}/ist-daten-v2-{year}-{month}.zip"
HTTP_TIMEOUT_SECONDS=120

# Routing
FETCHER_TIMEZONE=Europe/Zurich
# Optional: (YYYY-MM-DD): overrides "today", which decides permalink vs. archive
# Used for tests and to reproduce a past run's routing. Leave empty in normal operation.
FETCHER_REFERENCE_DATE=

# PostgreSQL (database service + transform job)
# USER/PASSWORD/DB only take effect when the db-data volume is created; changing
# them later requires recreating that volume (see README: Reset the database).
# Do not use `docker compose down -v`: it also deletes all raw files.
POSTGRES_USER=deng
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deng
# Published port for external queries. 127.0.0.1 = reachable from this machine only.
POSTGRES_BIND_ADDRESS=127.0.0.1
# Change it if 5432 is already used by a local PostgreSQL ("port is already allocated").
POSTGRES_HOST_PORT=5432
# How the transform job reaches the database inside the Docker network.
POSTGRES_HOST=database
POSTGRES_PORT=5432

# pgAdmin (optional web UI: docker compose --profile tools up -d pgadmin)
# Login for http://localhost:5050. Only applied when the pgadmin-data volume is created.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# Transform job
# Optional: other lines file, path INSIDE the container
# (default: /opt/transform/config/lines.yml = the repo's transform/config/lines.yml)
TRANSFORM_LINES_FILE=
# CSV rows per chunk; ~100k rows need ~250 MB on top of the baseline
TRANSFORM_CHUNK_SIZE=100000
# Validation limits in seconds (see README: validation rules)
TRANSFORM_MAX_ABS_DELAY_S=10800
TRANSFORM_MAX_SEGMENT_DURATION_S=21600
# Hard memory limit of the transform container
TRANSFORM_MEM_LIMIT=1g

# Orchestrator (Kestra, docker compose up -d -> http://localhost:8080)
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
KESTRA_BASIC_AUTH_PASSWORD=ChangeMe123
KESTRA_UI_PORT=8080
KESTRA_DB_USER=kestra
KESTRA_DB_PASSWORD=change-me
KESTRA_DB_NAME=kestra
DOCKER_SOCKET=/var/run/docker.sock
# Absolute path of this repo on the host (no trailing slash), e.g.
# /Users/til/dev/DataEngineering or, with Docker Desktop on Windows,
# /c/Users/til/dev/DataEngineering.
HOST_PROJECT_DIR=